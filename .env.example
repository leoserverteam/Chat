# Matrix Synapse Configuration
SYNAPSE_SERVER_NAME=matrix.leonet.site
SYNAPSE_REPORT_STATS=yes

# PostgreSQL Configuration
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=your_secure_password_here

# Domain Configuration
DOMAIN=leonet.site
SSL_CERT_PATH=/etc/letsencrypt/live/leonet.site/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/leonet.site/privkey.pem

# LiveKit Configuration
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Element Web Configuration
ELEMENT_HOME_SERVER_URL=https://matrix.leonet.site
ELEMENT_IDENTITY_SERVER_URL=https://vector.im
